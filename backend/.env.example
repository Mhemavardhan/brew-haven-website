# ==============================================================================
# Brew Haven Café — Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your Gmail address and 16-character Google App Password.
# 3. Never commit the actual .env file with sensitive credentials to Git.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origin (Your GitHub Pages URL or custom domain)
CLIENT_ORIGIN=https://mhemavardhan.github.io

# Gmail SMTP Authentication
# IMPORTANT: Use a 16-character Google App Password, NOT your regular Gmail password.
# Guide: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=brewhaven.reservations@gmail.com
EMAIL_PASS=your-16-char-app-password-here

# Café Owner Notification Recipient
OWNER_EMAIL=brewhaven.reservations@gmail.com

# Café Details for Email Signatures & Branding
CAFE_NAME=Brew Haven Café
CAFE_PHONE=+91 98765 43210
CAFE_ADDRESS=742 Evergreen Terrace, Downtown
CAFE_WEBSITE=https://mhemavardhan.github.io/brew-haven-website/
